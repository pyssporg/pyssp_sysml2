<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssm="http://ssp-standard.org/SSP1/SystemStructureParameterMapping" name="MappingComposition" version="1.0">
  <ssd:System name="MappingComposition">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="parameter_sets/NominalSet.ssv">
        <ssd:ParameterMapping>
          <ssm:ParameterMapping version="1.0">
            <ssm:MappingEntry source="n_waypoints" target="autopilot.waypointCount" />
            <ssm:MappingEntry source="waypoints_x_km[0]" target="autopilot.waypointX_km[0]" />
            <ssm:MappingEntry source="waypoints_x_km[1]" target="autopilot.waypointX_km[1]" />
          </ssm:ParameterMapping>
        </ssd:ParameterMapping>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="autopilot" source="" type="application/x-fmu-sharedlibrary">
        <ssd:Connectors>
          <ssd:Connector name="u.value" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y.value" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="waypointCount" kind="parameter">
            <ssc:Integer />
          </ssd:Connector>
          <ssd:Connector name="waypointX_km[0]" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="waypointX_km[1]" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0" stopTime="3600" />
</ssd:SystemStructureDescription>